# auth-svc — variáveis de ambiente.
# Copie para `.env` e ajuste para dev local.

# Porta HTTP do serviço (default 8081 conforme infra/.env.dev.example).
PORT=8081

# String de conexão Postgres. O schema `auth` é criado pela migration inicial.
DATABASE_URL=postgres://pickstack:pickstack-dev@localhost:5432/pickstack

# Segredo HS256 para assinatura de JWT. Em prod use um par RS256 + Secret K8s.
JWT_SECRET=dev-only-change-me-please-32chars-min

# Issuer/Audience embutidos no token (claims `iss`/`aud`).
JWT_ISSUER=pickstack-local
JWT_AUDIENCE=pickstack

# TTL do access token (segundos). Default 15 minutos.
ACCESS_TOKEN_TTL_SECONDS=900

# TTL do refresh token (segundos). Default 30 dias.
REFRESH_TOKEN_TTL_SECONDS=2592000

# Nível de log: debug | info | warn | error
LOG_LEVEL=debug

# Identificador do serviço nos logs estruturados.
SERVICE_NAME=auth-svc

# Se true, roda as migrations do diretório src/db/migrations no boot.
RUN_MIGRATIONS_ON_BOOT=true
