# api-gateway — variáveis de ambiente.

# Porta HTTP do gateway.
PORT=8080

# URLs dos serviços upstream. Em K8s, ClusterIP DNS (ex: http://auth-svc.pickstack.svc.cluster.local:8081).
AUTH_SVC_URL=http://localhost:8081
FOCUS_SVC_URL=http://localhost:8082
CARDS_SVC_URL=http://localhost:8083
TRILHA_SVC_URL=http://localhost:8084

# CORS: lista separada por vírgula. Em dev pode ser `*`. Em prod, restrinja.
ALLOWED_ORIGINS=*

# Rate limit por IP (sliding window).
# Janela em segundos e limite máximo de requisições por janela.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100

# Redis (opcional). Se ausente, fallback in-memory (não escala horizontal).
REDIS_URL=

# TTL (segundos) do cache em memória do resultado de /auth/verify.
VERIFY_CACHE_TTL_SECONDS=60

# Timeout (ms) para chamadas upstream.
UPSTREAM_TIMEOUT_MS=15000

# Nível de log: debug | info | warn | error
LOG_LEVEL=debug
SERVICE_NAME=api-gateway
