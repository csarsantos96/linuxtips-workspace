# URL pública do api-gateway. Em dev local, geralmente http://localhost:8080.
PUBLIC_API_URL=http://localhost:8080

# Limite (bytes) para o body de requests no adapter-node. 10 MiB por padrão.
BODY_SIZE_LIMIT=10485760

# Porta do servidor Node em produção (adapter-node). Não usada em vite dev.
PORT=3000
