# PICKStack — variáveis de ambiente para o stack de desenvolvimento local.
# Copie este arquivo para `.env.dev` antes de subir o docker compose:
#   cp infra/.env.dev.example infra/.env.dev
# Os defaults aqui são seguros apenas para dev local (NUNCA usar em produção).

# ----- Postgres -----
POSTGRES_USER=pickstack
POSTGRES_PASSWORD=pickstack-dev
POSTGRES_DB=pickstack
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_PORT=6379

# ----- NATS -----
NATS_CLIENT_PORT=4222
NATS_MONITORING_PORT=8222

# ----- MinIO -----
MINIO_ROOT_USER=pickstack
MINIO_ROOT_PASSWORD=pickstack-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----- Tenants -----
DEFAULT_TENANT_ID=local-dev

# ----- Serviços -----
AUTH_SVC_PORT=8081
FOCUS_SVC_PORT=8082
CARDS_SVC_PORT=8083
TRILHA_SVC_PORT=8084
API_GATEWAY_PORT=8080
WEB_PORT=5173

# ----- Auth/JWT -----
JWT_ISSUER=pickstack-local
JWT_AUDIENCE=pickstack
# Em produção: gerar par RS256 e montar como Secret.
# Para dev, deixe vazio — auth-svc cria/usa par efêmero.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ----- Logging -----
LOG_LEVEL=debug
LOG_FORMAT=json
