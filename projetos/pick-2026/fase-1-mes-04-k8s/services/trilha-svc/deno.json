{
  "name": "@pickstack/trilha-svc",
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read --no-check tests/",
    "build": "deno compile --allow-net --allow-env --allow-read --output dist/trilha-svc src/main.ts",
    "cache": "deno cache src/main.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.14",
    "hono/": "jsr:/@hono/hono@^4.6.14/",
    "drizzle-orm": "npm:drizzle-orm@^0.36.4",
    "drizzle-orm/": "npm:/drizzle-orm@^0.36.4/",
    "postgres": "npm:postgres@^3.4.5",
    "@std/assert": "jsr:@std/assert@^1.0.9",
    "@std/testing": "jsr:@std/testing@^1.0.5",
    "@std/uuid": "jsr:@std/uuid@^1.0.4"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
