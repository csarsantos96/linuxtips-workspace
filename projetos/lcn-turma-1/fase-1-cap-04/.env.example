# =============================================================================
# Giropops Status - variaveis de ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste para o seu ambiente:
#   cp .env.example .env
#
# IMPORTANTE: .env contem segredos. NUNCA comite. Veja o .gitignore.
# Em producao (cap 4), restrinja as permissoes:
#   chmod 600 /opt/giropops-status/config/.env
# =============================================================================

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Defina uma senha forte em producao. Mantenha o sinal de = mesmo vazio.
REDIS_PASSWORD=

# --- Aplicacao ---------------------------------------------------------------
APP_PORT=5000
APP_VERSION=1.0.0
# Timeout (segundos) dos health checks HTTP que a app faz nos targets.
CHECK_TIMEOUT=5
# Quantos checks por servico manter no historico (lista Redis).
HISTORY_LIMIT=100

# --- Logging (cap 3) ---------------------------------------------------------
# Niveis: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Caminho absoluto de um arquivo de log. Se vazio, loga apenas em stdout.
# Em producao (cap 7), aponte para /opt/giropops-status/logs/app.log
LOG_FILE=

# --- Dev ---------------------------------------------------------------------
# Nunca habilite debug=true em producao - expoe o console interativo do Flask.
FLASK_DEBUG=false
