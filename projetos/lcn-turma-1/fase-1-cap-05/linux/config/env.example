# =============================================================================
# Giropops Status - .env de producao (referencia)
# =============================================================================
# Este arquivo eh a referencia das variaveis de ambiente que o
# giropops-status.service espera carregar via EnvironmentFile=.
#
# Instalacao no servidor (cap 5):
#   sudo install -o giropops -g giropops -m 0640 \
#       linux/config/env.example \
#       /opt/giropops-status/config/.env
#
# Depois edite com:
#   sudo -u giropops vim /opt/giropops-status/config/.env
#
# Permissoes: 0640 (dono le/escreve, grupo le, outros nada). Em servidor
# com segredo de verdade no REDIS_PASSWORD, prefira 0600.
#
# NUNCA comite o .env real - so este .example.
# =============================================================================

# --- Redis -------------------------------------------------------------------
# Redis-server local instalado via APT escuta em localhost:6379.
REDIS_HOST=localhost
REDIS_PORT=6379
# Producao real: defina senha forte e configure 'requirepass' no /etc/redis/redis.conf.
# Mantenha o = mesmo vazio em dev (Python lib espera string, nao undefined).
REDIS_PASSWORD=

# --- Aplicacao ---------------------------------------------------------------
# Porta TCP em que o Flask escuta. Se mudar aqui, alinhe com o systemd
# (ex.: drop-in override com ExecStart) e abra a porta no firewall (cap 9).
APP_PORT=5000

# Versao logica - aparece no /version e no /metrics (label prometheus).
APP_VERSION=1.0.0

# Timeout (segundos) dos health checks HTTP que a app faz nos targets
# cadastrados. Cuidado pra nao deixar muito alto - trava o worker.
CHECK_TIMEOUT=5

# Quantos checks por servico manter no historico (lista no Redis).
HISTORY_LIMIT=100

# --- Logging (cap 3) ---------------------------------------------------------
# Niveis: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Em producao: INFO ou WARNING. DEBUG vaza dados sensiveis nos logs.
LOG_LEVEL=INFO

# Caminho absoluto pro arquivo de log. Vazio = so stdout (vai pro journalctl
# via systemd). Em producao com volume dedicado (cap 7), aponte pra
# /opt/giropops-status/logs/app.log.
LOG_FILE=

# --- Flask -------------------------------------------------------------------
# NUNCA habilite em producao - expoe o console interativo do Flask pro
# mundo, e quem tem acesso ao console executa codigo arbitrario na sua VM.
FLASK_DEBUG=false
